<%= form_with model: @imap_account, url: form_url, method: form_method, class: "space-y-4" do |f| %>
  <% if @imap_account.errors.any? %>
    <div class="p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700">
      <%= @imap_account.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :label, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :label, class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
    <p class="text-xs text-gray-500 mt-1">Herkenbare naam (bijv. "HEY").</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :host, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :host, class: "w-full px-3 py-2 border border-gray-300 rounded-lg", placeholder: "imap.hey.com" %>
    </div>
    <div>
      <%= f.label :port, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :port, class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
    </div>
  </div>

  <div>
    <%= f.label :username, "Gebruikersnaam / e-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :username, class: "w-full px-3 py-2 border border-gray-300 rounded-lg", autocomplete: "username" %>
  </div>

  <div>
    <%= f.label :password, "Wachtwoord (app-password aanbevolen)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.password_field :password, class: "w-full px-3 py-2 border border-gray-300 rounded-lg", autocomplete: "new-password", placeholder: @imap_account.persisted? ? "Laat leeg om te behouden" : nil %>
  </div>

  <div>
    <%= f.label :folder, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :folder, class: "w-full px-3 py-2 border border-gray-300 rounded-lg", placeholder: "INBOX" %>
    <p class="text-xs text-gray-500 mt-1">HEY's Imbox is simpelweg <code>INBOX</code>.</p>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :enabled, class: "rounded border-gray-300" %>
    <%= f.label :enabled, "Actief" %>
  </div>

  <div class="flex justify-end gap-3 pt-2">
    <%= link_to "Annuleren", settings_imap_accounts_path, class: "px-4 py-2 text-sm text-gray-700 hover:text-gray-900" %>
    <%= f.submit class: "px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 cursor-pointer" %>
  </div>
<% end %>
