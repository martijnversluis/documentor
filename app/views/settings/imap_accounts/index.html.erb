<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">IMAP-accounts</h1>
    <p class="text-sm text-gray-500 mt-1">HEY of een andere IMAP-mailbox koppelen om Imbox-berichten op je dashboard te zien.</p>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
      <h2 class="font-semibold text-gray-900">Accounts</h2>
      <%= link_to new_settings_imap_account_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Account toevoegen
      <% end %>
    </div>

    <% if @imap_accounts.any? %>
      <ul class="divide-y divide-gray-100">
        <% @imap_accounts.each do |account| %>
          <li class="px-4 py-4 flex items-center justify-between">
            <div>
              <p class="font-medium text-gray-900"><%= account.label %></p>
              <p class="text-sm text-gray-500"><%= account.username %> &middot; <%= account.host %>:<%= account.port %> &middot; <%= account.folder %></p>
            </div>
            <div class="flex items-center gap-2">
              <%= button_to toggle_settings_imap_account_path(account), method: :patch, class: "p-2 cursor-pointer #{account.enabled? ? 'text-green-500 hover:text-green-600' : 'text-gray-400 hover:text-green-500'}", title: account.enabled? ? "Uitschakelen" : "Inschakelen", form: { class: "inline" } do %>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
              <% end %>
              <%= link_to edit_settings_imap_account_path(account), class: "p-2 text-gray-400 hover:text-blue-600", title: "Bewerken" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              <% end %>
              <%= button_to settings_imap_account_path(account), method: :delete, class: "p-2 text-gray-400 hover:text-red-600", title: "Verwijderen", form: { data: { turbo_confirm: "Weet je zeker dat je dit account wilt verwijderen?" } } do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-4 py-12 text-center text-gray-500">
        <p class="mb-2">Nog geen accounts</p>
        <p class="text-sm">Voeg bijvoorbeeld je HEY-account toe met host <code>imap.hey.com</code>, poort <code>993</code>.</p>
      </div>
    <% end %>
  </div>
</div>
