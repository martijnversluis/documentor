<% if messages.empty? %>
  <div class="text-center py-4 text-gray-500 text-sm">
    Imbox is leeg
  </div>
<% else %>
  <ul class="divide-y divide-gray-100">
    <% messages.first(20).each do |msg| %>
      <li class="px-4 py-2.5 hover:bg-gray-50 group"
          id="hey-item-<%= msg[:thread_id] %>">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 mt-0.5">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-purple-100 text-purple-600">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
              </svg>
            </span>
          </div>
          <div class="flex-1 min-w-0">
            <a href="https://app.hey.com/" target="_blank" rel="noopener noreferrer">
              <p class="text-sm text-gray-900 truncate">
                <%= msg[:subject].presence || "(geen onderwerp)" %>
              </p>
              <p class="text-xs text-gray-500 truncate">
                <%= msg[:from] %>
                <% if msg[:date] %>
                  <span class="mx-1">&middot;</span>
                  <span><%= time_ago_in_words(msg[:date]) %> geleden</span>
                <% end %>
              </p>
            </a>
          </div>
          <div class="flex-shrink-0 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <%= link_to new_mail_promote_path(
                  description: "[HEY van #{msg[:from]}] #{msg[:subject]}",
                  notes: "https://app.hey.com/"
                ),
                class: "p-1 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded",
                title: "Promoveer naar actiepunt",
                data: { turbo_frame: "modal" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            <% end %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
  <% if messages.size > 20 %>
    <div class="px-4 py-2 text-center text-xs text-gray-500 border-t border-gray-100">
      en <%= messages.size - 20 %> meer...
    </div>
  <% end %>
<% end %>
