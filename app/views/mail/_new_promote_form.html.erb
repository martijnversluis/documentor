<%# locals: (action_item:, thread_id:, errors: nil) %>
<div class="fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-lg w-full mx-4">
    <div class="p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Mail promoveren naar actiepunt</h2>

      <% if errors&.any? %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700">
          <%= errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <%= form_with url: mail_promote_path, method: :post, class: "space-y-4", data: { turbo_stream: true } do |f| %>
        <%= hidden_field_tag :thread_id, thread_id %>
        <%= hidden_field_tag "action_item[notes]", action_item.notes %>

        <div>
          <%= f.label "action_item[description]", "Omschrijving", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area "action_item[description]", value: action_item.description, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent", autofocus: true %>
        </div>

        <div>
          <%= f.label "action_item[dossier_id]", "Dossier", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= render "shared/dossier_select",
              field_name: "action_item[dossier_id]",
              selected_id: action_item.dossier_id,
              include_blank: "Inbox (geen dossier)",
              show_all: true %>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= f.label "action_item[due_date]", "Datum", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.date_field "action_item[due_date]", value: action_item.due_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          </div>
          <div>
            <%= f.label "action_item[context]", "Context", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= render "shared/context_select", field_name: "action_item[context]", selected: action_item.context, include_blank: "Geen context" %>
          </div>
        </div>

        <div class="flex justify-end space-x-3 pt-4">
          <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900" onclick="document.getElementById('modal').innerHTML = ''; return false;">Annuleren</button>
          <%= f.submit "Toevoegen", class: "px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
